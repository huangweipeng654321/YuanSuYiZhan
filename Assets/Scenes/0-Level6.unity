    - target: {fileID: 6512040357551553570, guid: d2ce7c9c1c3c2b34c911daa8e473779e, type: 3}
      propertyPath: m_Name
      value: Canvases
      objectReference: {fileID: 0}
    - target: {fileID: 8639340927110408206, guid: d2ce7c9c1c3c2b34c911daa8e473779e, type: 3}
      propertyPath: m_Text
      value: "\u5316\u5408\r\nNaOH+CO\u2082=NaHCO\u2083\r\n\u590D\u5206\u89E3\uFF082\u751F2\uFF09\r\nHCl+NaOH=NaCl+H\u2082O\r\nCO\u2082
        + 2NaOH = Na\u2082CO\u2083 + H\u2082O\r\nNaHCO\u2083+NaOH=Na\u2082CO\u2083+H\u2082O\r\nNa\u2082CO\u2083+H\u2082O=\u52A0\u70ED=NaHCO\u2083+NaOH\r\nNa\u2082CO\u2083
        + HCl = NaCl + NaHCO\u2083\r\n\u590D\u5206\u89E3\uFF082\u751F3\uFF09\r\n2NaCl
        + 2H\u2082O =\u7535\u89E3=2NaOH + H\u2082 + Cl\u2082\r\nNa\u2082CO\u2083
        + 2HCl = 2NaCl + H\u2082O + CO\u2082\u2191\r\nNaHCO\u2083+HCl=CO\u2082\u2191+H\u2082O+2NaCl"
      objectReference: {fileID: 0}
