7528\u4e00\u4e2a\u811a\u672c\uff0c\u5305\u62ec\u7f6e\u6362\u53cd\u5e94\uff0c\u5316\u5408\u53cd\u5e94\uff0c\u590d\u5206\u89e3\u53cd\u5e94\uff08plus\uff09\n2.\u6709\u4e24\u4e2a\u751f\u6210\u6846\u7684\u53cd\u5e94\u53d1\u751f\u5668\u90fd\u590d\u7528\u4e00\u4e2a\u811a\u672c\uff0c\u5305\u62ec\u7f6e\u6362\u53cd\u5e94\uff0c\u5206\u89e3\u53cd\u5e94\uff0c\u590d\u5206\u89e3\u53cd\u5e94\n\u5982\u6b64\u5c31\u4e0d\u7528\u5728\u4e0d\u540c\u7684\u4ee3\u7801\u4e2d\u4e3a\u540c\u4e00\u5904\u53d8\u5316\u53cd\u590d\u4fee\u6539\u3002","colorTheme":"Classic","guid":"06ad92f8-2cf7-4ddd-a997-7d4528bcd95e","$type":"Unity.VisualScripting.StickyNote"},{"position":{"xMin":2525.0,"yMin":1243.0,"xMax":2866.2,"yMax":1358.0},"title":"\u4ee3\u7801\u590d\u7528\u7387\u6700\u9ad8\u5f62\u5f0f\uff1a\u7edf\u4e00\u811a\u672c\u63a7\u5236","body":"\u6838\u5fc3\u903b\u8f91\u7ed3\u6784\u76f8\u4f3c\u7684\u4ee3\u7801\u53ef\u4ee5\u9009\u62e9\u4f7f\u7528\u540c\u4e00\u4ee3\u7801\u63a7\u5236\u3002\u53ea\u9700\u8981\u5728\u4e0d\u540c\u4e4b\u5904\u5206\u6d41\u521b\u5efa\u4e0d\u540c\u903b\u8f91\u5373\u53ef\u3002\u5206\u6d41\u8981\u5584\u7528Control\u7684if\u3001switch\u3001select\u7b49\u8282\u70b9\u3002\u7edf\u4e00\u7684\u811a\u672c\u903b\u8f91\u53ef\u65b9\u4fbf\u4ee3\u7801\u7ba1\u7406\u548c\u7ef4\u62a4\u3002","colorTheme":"Classic","guid":"9bcc790d-fc13-4c8b-8d03-6feaffd09643","$type":"Unity.VisualScripting.StickyNote"},{"position":{"xMin":5011.0,"yMin":962.0,"xMax":5237.0,"yMax":1117.0},"title":"\u4f18\u5316\u53ef\u80fd","body":"\u6bd4\u5982\u8fd9\u4e2a\u5730\u65b9\u8ba1\u7b97\u5f53\u524d\u53ef\u8fdb\u884c\u53cd\u5e94\u6570\uff08\u4e00\u683c\u53cd\u5e94\u7269\uff09\u548c\uff08\u4e24\u683c\u53cd\u5e94\u7269\uff09\uff0c\u4e5f\u53ef\u4ee5\u8003\u8651\u628a\u4ed6\u4eec\u7528\u4e00\u4e2a\u811a\u672c\u63a7\u5236\uff0c\u4e5f\u5c31\u80fd\u5f97\u5230\u4ee3\u7801\u590d\u7528\u7684\u6700\u9ad8\u5f62\u5f0f\u2014\u2014\u7edf\u4e00\u811a\u672c\u63a7\u5236\u3002\u5982\u6b64\uff0c\u91cd\u590d\u7684\u903b\u8f91\u90e8\u5206\u5c31\u4e0d\u9700\u8981\u518d\u5199\u800c\u662f\u5f97\u5230\u7edf\u4e00\uff0c\u65b9\u4fbf\u4e86\u7ba1\u7406\u548c\u7ef4\u62a4\u3002\u53ea\u9700\u8981\u8003\u8651\u5982\u4f55\u5206\u6d41\u4ee5\u53ca\u9700\u8981\u6267\u884c\u7684\u4e0d\u540c\u903b\u8f91\u3002","colorTheme":"Orange","guid":"e39e0aaf-160d-4dff-8179-f684947336d0","$type":"Unity.VisualScripting.StickyNote"}],"$version":"A"}}'
